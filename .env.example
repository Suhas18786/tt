# ---- copy to .env and change every secret before deploying ----
ENVIRONMENT=production            # "production" refuses to start without SECRET_KEY
POSTGRES_USER=timetable
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=timetable
DATABASE_URL=postgresql+psycopg2://timetable:change-me-db-password@db:5432/timetable
SECRET_KEY=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SOLVER_WORKERS=8                  # CP-SAT search threads
WEB_WORKERS=2                     # uvicorn processes (each solve occupies one worker while running)
SEED_ON_START=true               # load the sample data on first start; set false for a clean install
